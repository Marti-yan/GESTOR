# O servidor lê variáveis do ambiente. Para carregar este arquivo:
# node --env-file=.env server/index.mjs
HOST=127.0.0.1
PORT=4317
DATA_DIR=./.data
# Obrigatório para exposição pública/LAN sem o instalador Electron.
# Defina uma senha exclusiva de pelo menos 12 caracteres.
# ADMIN_PASSWORD=
# Em produção HTTPS:
# COOKIE_SECURE=true
