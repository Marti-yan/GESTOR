{
  "name": "pronto-gestor",
  "version": "0.1.1",
  "private": true,
  "description": "Cardápio digital, gestor de pedidos e impressão térmica — MVP",
  "type": "module",
  "author": "Pronto",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "build:windows": "npm run build && node scripts/prepare-windows.mjs && electron-builder --win nsis --x64",
    "verify:package": "node scripts/verify-package.cjs release/win-unpacked",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "br.app.pronto.gestor",
    "productName": "Pronto Gestor",
    "artifactName": "Pronto-Gestor-${version}-Windows-x64.${ext}",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/verify-package.cjs",
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "shared",
        "to": "shared",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".runtime/windows/node.exe",
        "to": "node.exe"
      },
      {
        "from": ".runtime/server.cjs",
        "to": "server-bundle.cjs"
      },
      {
        "from": ".runtime/windows/Node-LICENSE.txt",
        "to": "Node-LICENSE.txt"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pronto Gestor",
      "deleteAppDataOnUninstall": false,
      "include": "desktop/installer.nsh",
      "script": "desktop/installer.nsi",
      "installerLanguages": [
        "pt_BR"
      ]
    }
  }
}
